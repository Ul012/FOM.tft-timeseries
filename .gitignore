# ============================================================================
# PYTHON ENVIRONMENT
# ============================================================================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ============================================================================
# IDE & EDITORS
# ============================================================================
.idea/
.vscode/
.ipynb_checkpoints/

# ============================================================================
# OPERATING SYSTEM
# ============================================================================
.DS_Store
Thumbs.db

# ============================================================================
# DATA DIRECTORIES
# ============================================================================
# Raw Data - nicht versioniert (Kaggle-Lizenz, Download-Links in README)
data/raw/

# Processed Data (wird generiert)
data/interim/
data/processed/

# ============================================================================
# MODEL ARTIFACTS & OUTPUTS
# ============================================================================
# Logs - ignorieren (TensorBoard, regenerierbar)
logs/
lightning_logs/

# ============================================================================
# RESULTS - TFT
# ============================================================================
results/*
!results/tft/
!results/tft/runs/
!results/tft/runs/*/
!results/tft/eval/
!results/tft/eval/*/
!results/tft/optuna/
!results/tft/optuna/*/

# Nur diese Unterordner ignorieren
results/tft/runs/**/forecasts/
results/tft/runs/**/models/
results/tft/runs/**/plots/
results/tft/eval/**/plots/
results/tft/optuna/**/analysis/
results/tft/optuna/**/plots/
results/tft/optuna/**/trial_*/

# ============================================================================
# RESULTS - PROPHET
# ============================================================================
!results/prophet/
!results/prophet/runs/
!results/prophet/runs/*/
!results/prophet/optuna/
!results/prophet/optuna/*/

# Nur diese Unterordner ignorieren
results/prophet/runs/**/forecasts/
results/prophet/runs/**/models/
results/prophet/runs/**/plots/
results/prophet/optuna/**/trial_*/

# ============================================================================
# RESULTS - ARIMA
# ============================================================================
!results/arima/
!results/arima/runs/
!results/arima/runs/*/

# Nur diese Unterordner ignorieren
results/arima/runs/**/forecasts/
results/arima/runs/**/models/
results/arima/runs/**/plots/

# Optuna: nur Study-Zusammenfassungen teilen
!results/arima/optuna/
!results/arima/optuna/*/
results/arima/optuna/*/*
!results/arima/optuna/*/study_*.json
!results/arima/optuna/*/study_*.csv


# ============================================================================
# LARGE FILES - IMMER IGNORIEREN
# ============================================================================
# Checkpoints ausschließen (zu groß ~50-100MB pro Stück)
**/checkpoints/

# Prophet Modelle (zu groß ~1-10MB pro Modell)
**/models/*.pkl

# Optuna DBs (zu groß, regenerierbar)
**/*.db
**/prophet_studies.db
**/tft_studies.db

# Plots (regenerierbar)
**/plots/

# Trial-Ordner (Zwischenergebnisse, regenerierbar)
**/trial_*/

# ============================================================================
# ARCHIVE & NOTES
# ============================================================================
archive/
notes/

# ============================================================================
# TEMPORARY & CACHE
# ============================================================================
tmp/
cache/
*.log
*.bak
*.tmp

# ============================================================================
# SERIALIZED DATA
# ============================================================================
*.pkl
*.npy
*.npz
*.parquet

# ============================================================================
# SECURITY & CREDENTIALS
