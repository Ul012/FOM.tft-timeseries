# ============================================================================
# GitIgnore – FOM.tft-timeseries
# ============================================================================
# Datum: 2025-11-25
# ============================================================================

# ============================================================================
# PYTHON ENVIRONMENT
# ============================================================================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ============================================================================
# IDE & EDITORS
# ============================================================================
.idea/
.vscode/
.ipynb_checkpoints/

# ============================================================================
# OPERATING SYSTEM
# ============================================================================
.DS_Store
Thumbs.db

# ============================================================================
# DATA DIRECTORIES
# ============================================================================
# Raw Data - nicht versioniert (Kaggle-Lizenz, Download-Links in README)
data/raw/

# Processed Data (wird generiert)
data/interim/
data/processed/

# ============================================================================
# MODEL ARTIFACTS & OUTPUTS
# ============================================================================
# Logs - ignorieren (TensorBoard, regenerierbar)
logs/
lightning_logs/

# ============================================================================
# RESULTS - TFT
# ============================================================================

# Grundregel: Results global ignorieren
results/*
!results/tft/

# ---------------------------------------------------------------------------
# RUNS
# ---------------------------------------------------------------------------
# Runs grundsätzlich erlauben
!results/tft/runs/

# Alles in Runs ignorieren …
results/tft/runs/**/*
# … außer zusammenfassende Ergebnisse
!results/tft/runs/**/summary.json
!results/tft/runs/**/results.json
!results/tft/runs/**/eval_*.json
!results/tft/runs/**/eval_*.csv

# Explizit nie versionieren (groß / reproduzierbar)
results/tft/runs/**/forecasts/
results/tft/runs/**/models/
results/tft/runs/**/plots/

# ---------------------------------------------------------------------------
# EVAL
# ---------------------------------------------------------------------------
# Eval-Ordner erlauben
!results/tft/eval/

# Alles ignorieren …
results/tft/eval/**/*
# … außer CSV / JSON Summaries
!results/tft/eval/**/*.csv
!results/tft/eval/**/*.json

# ---------------------------------------------------------------------------
# OPTUNA
# ---------------------------------------------------------------------------
# Optuna-Basis erlauben
!results/tft/optuna/

# Alles ignorieren …
results/tft/optuna/**/*
# … außer Dataset-Unterordner
!results/tft/optuna/*/

# … und nur Study-Zusammenfassungen
!results/tft/optuna/*/study_*.csv
!results/tft/optuna/*/study_*.json

# Nie versionieren (reproduzierbar durch Scripts)
results/tft/optuna/**/analysis/
results/tft/optuna/**/plots/
results/tft/optuna/**/trial_*/
results/tft/optuna/**/*.db

# ============================================================================
# RESULTS - PROPHET
# ============================================================================
!results/prophet/
results/prophet/*

!results/prophet/runs/
# Runs: nur zusammenfassende Ergebnisse teilen
results/prophet/runs/**/forecasts/
results/prophet/runs/**/models/

!results/prophet/eval/
!results/prophet/optuna/

# Prophet Optuna - selektiv teilen
results/prophet/optuna/*
!results/prophet/optuna/*/
results/prophet/optuna/*/*
!results/prophet/optuna/*/study_*.json  # ✅ Study-Zusammenfassungen
!results/prophet/optuna/*/study_*.csv   # ✅ Trial-Übersichten

# ============================================================================
# RESULTS - ARIMA
# ============================================================================
!results/arima/
results/arima/*

# Runs: nur zusammenfassende Ergebnisse teilen
!results/arima/runs/
+!results/arima/runs/*/
+!results/arima/runs/*/*/
results/arima/runs/**/*
!results/arima/runs/**/summary.json
!results/arima/runs/**/eval_*.json

# Optuna: nur Study-Zusammenfassungen teilen
!results/arima/optuna/
results/arima/optuna/*
!results/arima/optuna/*/
results/arima/optuna/*/*
!results/arima/optuna/*/study_*.json
!results/arima/optuna/*/study_*.csv


# ============================================================================
# LARGE FILES - IMMER IGNORIEREN
# ============================================================================
# Checkpoints ausschließen (zu groß ~50-100MB pro Stück)
**/checkpoints/

# Prophet Modelle (zu groß ~1-10MB pro Modell)
**/models/*.pkl

# Optuna DBs (zu groß, regenerierbar)
**/*.db
**/prophet_studies.db
**/tft_studies.db

# Plots (regenerierbar)
**/plots/

# Trial-Ordner (Zwischenergebnisse, regenerierbar)
**/trial_*/

# ============================================================================
# ARCHIVE & NOTES
# ============================================================================
archive/
notes/

# ============================================================================
# TEMPORARY & CACHE
# ============================================================================
tmp/
cache/
*.log
*.bak
*.tmp

# ============================================================================
# SERIALIZED DATA
# ============================================================================
*.pkl
*.npy
*.npz
*.parquet

# ============================================================================
# SECURITY & CREDENTIALS
# ============================================================================
.env
*.key
*.token